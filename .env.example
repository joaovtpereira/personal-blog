# Endereço público do site: vai nos links compartilhados e nas prévias do WhatsApp/Facebook.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Firebase (comentários e reações). Conta de serviço: Console do Firebase › Configurações do projeto ›
# Contas de serviço › Gerar nova chave privada. Sem estas variáveis, tudo fica em memória (desenvolvimento).
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# A chave inteira entre aspas, com as quebras de linha como \n
FIREBASE_PRIVATE_KEY=
