{
  "name": "jvp-editor",
  "version": "0.1.0",
  "private": true,
  "description": "Editor desktop de conteúdo do blog JVP (Electron + Vite + React).",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "npm run build:electron && node scripts/dev.mjs",
    "dev:renderer": "vite",
    "build": "npm run typecheck && vite build && npm run build:electron",
    "build:electron": "tsc -p tsconfig.electron.json",
    "start": "npm run build && electron .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.electron.json --noEmit"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.7.0",
    "typescript": "^5",
    "vite": "8.3.4"
  }
}
